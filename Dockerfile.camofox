FROM node:22-slim

LABEL description="Camofox Browser - Anti-detection browser server with VNC"
LABEL source="https://github.com/jo-inc/camofox-browser"

# 清华源加速
RUN sed -i 's|deb.debian.org|mirrors.tuna.tsinghua.edu.cn|g' /etc/apt/sources.list.d/debian.sources 2>/dev/null || \
    sed -i 's|deb.debian.org|mirrors.tuna.tsinghua.edu.cn|g' /etc/apt/sources.list 2>/dev/null

RUN apt-get update && apt-get install -y \
    libgtk-3-0 libdbus-glib-1-2 libxt6 libasound2 \
    libx11-xcb1 libxcomposite1 libxcursor1 libxdamage1 \
    libxfixes3 libxi6 libxrandr2 libxrender1 libxss1 libxtst6 \
    libegl1-mesa libgl1-mesa-dri libgbm1 xvfb \
    fonts-liberation fonts-noto-color-emoji fonts-noto-cjk fontconfig \
    x11vnc novnc websockify python3-websockify \
    build-essential \
    ca-certificates curl unzip python3-minimal \
    && rm -rf /var/lib/apt/lists/*

# 复制自定义 VNC watcher（修复 Xvfb 检测 + x11vnc 崩溃恢复）
COPY scripts/vnc-watcher.sh /tmp/vnc-watcher.sh

# Install Camofox + 应用补丁
RUN npm install -g only-allow@1.2.2 && \
    npm install -g @askjo/camofox-browser@1.11.2 && \
    sed -i 's/vdDisplay = localVirtualDisplay.get()/vdDisplay = await localVirtualDisplay.get()/' \
      /usr/local/lib/node_modules/@askjo/camofox-browser/server.js && \
    # 启用 VNC plugin（默认 disabled，需手动改 config.json）
    sed -i 's/"vnc": {\s*"enabled": false/"vnc": {"enabled": true/' \
      /usr/local/lib/node_modules/@askjo/camofox-browser/camofox.config.json && \
    # 安装 VNC watcher
    cp /tmp/vnc-watcher.sh /usr/local/lib/node_modules/@askjo/camofox-browser/plugins/vnc/vnc-watcher.sh && \
    chmod +x /usr/local/lib/node_modules/@askjo/camofox-browser/plugins/vnc/vnc-watcher.sh && \
    apt-get purge -y build-essential && apt-get autoremove -y && \
    rm -rf /root/.cache/node-gyp /tmp/* && \
    npm cache clean --force

ENV NODE_ENV=production
ENV CAMOFOX_PORT=9377
ENV NOVNC_PORT=6080
ENV ENABLE_VNC=1
ENV VNC_PASSWORD=hermes
ENV MAX_OLD_SPACE_SIZE=256
ENV CAMOFOX_CRASH_REPORT_ENABLED=false
ENV TZ=Asia/Shanghai

EXPOSE 9377 6080
CMD ["sh", "-c", "node --max-old-space-size=${MAX_OLD_SPACE_SIZE:-256} /usr/local/lib/node_modules/@askjo/camofox-browser/server.js"]
