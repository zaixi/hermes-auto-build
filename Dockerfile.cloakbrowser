FROM cloakhq/cloakbrowser:latest

LABEL maintainer="liyujiang"
LABEL description="CloakBrowser with VNC/noVNC — stealth Chromium that you can see and control"

# Install VNC components
RUN apt-get update && apt-get install -y --no-install-recommends \
    x11vnc novnc websockify python3-websockify \
    && rm -rf /var/lib/apt/lists/*

# Patch cloakserve to support CLOAKSERVE_DATA_DIR env var
RUN python3 -c "
import re
with open('/usr/local/bin/cloakserve', 'r') as f:
    content = f.read()
old = '''def _default_data_dir() -> str:
    \"\"\"Smart default: container \u2192 /tmp/cloakserve, bare metal \u2192 ~/.cloakbrowser/cloakserve.\"\"\"
    if os.path.exists('/.dockerenv') or os.path.exists('/run/.containerenv'):
        return '/tmp/cloakserve'
    return str(Path.home() / '.cloakbrowser' / 'cloakserve')'''
new = '''def _default_data_dir() -> str:
    \"\"\"Smart default: container \u2192 /tmp/cloakserve, bare metal \u2192 ~/.cloakbrowser/cloakserve.\"\"\"
    env_dir = os.environ.get('CLOAKSERVE_DATA_DIR')
    if env_dir:
        return env_dir
    if os.path.exists('/.dockerenv') or os.path.exists('/run/.containerenv'):
        return '/tmp/cloakserve'
    return str(Path.home() / '.cloakbrowser' / 'cloakserve')'''
content = content.replace(old, new)
with open('/usr/local/bin/cloakserve', 'w') as f:
    f.write(content)
print('Patched cloakserve with CLOAKSERVE_DATA_DIR support')
"

# Copy custom entrypoint with VNC support
COPY scripts/cloakbrowser-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENV VNC_PASSWORD=hermes
ENV VNC_PORT=5900
ENV NOVNC_PORT=8080
ENV DISPLAY=:99
ENV TZ=Asia/Shanghai
ENV CLOAKSERVE_DATA_DIR=/root/.cloakbrowser/data

EXPOSE 8080 9222 5900

ENTRYPOINT ["/entrypoint.sh"]
CMD ["cloakserve"]
